rules_version = '2';

// ============================================================================
// Security rules for the Secret Hitler companion.
//
// These rules are the ENTIRE security boundary. There is no server and no Cloud
// Functions (those need the paid plan), so anything not forbidden here is
// allowed to any signed-in user on the internet. Deploy with:
//     firebase deploy --only firestore:rules
// Design notes live in BACKEND_PLAN.md.
//
// DATA-SAFETY INVARIANT (do not weaken — see DATA_SAFETY.md):
//   No client can ever bulk-delete recorded history.
//     • The Firestore client SDK has no "delete a collection" operation, so the
//       app can only ever delete ONE document per call.
//     • `games` and `voices` allow `delete` solely to a document's own author
//       (createdBy) or the group's owner — never to another member — and `update`
//       is `if false`, so history can be removed one item at a time but never
//       silently rewritten.
//   The only way to mass-delete is admin/CLI tooling (firebase firestore:delete),
//   which BYPASSES these rules entirely. That is exactly what DATA_SAFETY.md
//   forbids and why the destructive test is hard-gated. Rules cannot police the
//   project owner's terminal — a backup discipline does.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid()      { return request.auth.uid; }

    // ---- admin ----
    // A single privileged account (the site owner). Enforced HERE, in the rules —
    // this is the real boundary; the app only hides UI. `request.auth.token.email`
    // comes from the signed Firebase Auth token, so it cannot be spoofed, and the
    // email is uniquely claimed by one account, so no one else can present it.
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'timhadfield7@gmail.com';
    }

    // Membership check. Reads the parent group doc, so it costs ONE document
    // read per query (not per document returned) — which is exactly why
    // memberUids is denormalised onto the group instead of living only in the
    // members subcollection.
    function group(gid) {
      return get(/databases/$(database)/documents/groups/$(gid)).data;
    }
    function isMember(gid) {
      return signedIn() && uid() in group(gid).memberUids;
    }

    // ---- profiles: fetchable by id, writable only by you ----
    // 'get' is open (you need a uid to ask, and members already expose display
    // names within a group) but 'list' is CLOSED: otherwise any signed-in user
    // could enumerate every account on the service and read their names.
    match /profiles/{userId} {
      allow get:    if signedIn();
      allow list:   if false;
      allow create: if signedIn() && uid() == userId
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() > 0
                    && request.resource.data.displayName.size() <= 60;
      allow update: if signedIn() && uid() == userId
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() > 0
                    && request.resource.data.displayName.size() <= 60;
      allow delete: if false; // deleting a profile would orphan game history

      // ---- personal game metadata (label + favorite) ----
      // A user's own labels/favorites for games, keyed by game id. Fully
      // private (only you read or write it) and completely separate from the
      // append-only game docs, so history is never touched. Sizes are capped.
      match /gameMeta/{gameId} {
        allow read, delete: if signedIn() && uid() == userId;
        allow create, update: if signedIn() && uid() == userId
                    && (!('label' in request.resource.data)
                        || (request.resource.data.label is string
                            && request.resource.data.label.size() <= 60))
                    && (!('favorite' in request.resource.data)
                        || request.resource.data.favorite is bool);
      }

      // ---- invitation inbox ----
      // Lets you invite someone you've played with by name instead of sending
      // them a link. Anyone signed in may drop an invite in your inbox (it
      // carries no access by itself — accepting is an ordinary invite-join, so
      // a closed group still can't be entered), and only you can read or clear
      // it. Deliberately not a friend graph: no handshake, nothing to maintain.
      match /invites/{groupId} {
        allow read, delete: if signedIn() && uid() == userId;
        allow create:       if signedIn()
                            && request.resource.data.from == uid()
                            && request.resource.data.groupName is string
                            && request.resource.data.groupName.size() <= 60;
        allow update:       if false;
      }
    }

    match /groups/{groupId} {

      // 'get' is open to any signed-in user because the random group id in an
      // invite link IS the secret that grants entry. 'list' stays CLOSED so
      // groups can never be enumerated — do not loosen it.
      allow get:  if signedIn();
      allow list: if false;

      allow create: if signedIn()
                    && request.resource.data.ownerUid == uid()
                    && request.resource.data.memberUids == [uid()]
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 60
                    && request.resource.data.inviteCode is string;

      // Two distinct cases:
      //  1. an existing member editing the group (rename, roster changes)
      //  2. a NON-member joining via an invite link — allowed to append only
      //     their OWN uid and to change nothing else. Pinning every other
      //     field is what stops a stranger renaming or hijacking the group.
      //     `joinOpen` makes an invite link revocable: members can close the
      //     group and old links stop working. Absent on groups created before
      //     the field existed, hence the .get() default of true.
      allow update: if signedIn() && (
                      isMember(groupId)
                      || (
                        resource.data.get('joinOpen', true) == true
                        && request.resource.data.memberUids == resource.data.memberUids.concat([uid()])
                        && request.resource.data.name       == resource.data.name
                        && request.resource.data.ownerUid   == resource.data.ownerUid
                        && request.resource.data.inviteCode == resource.data.inviteCode
                        && request.resource.data.get('joinOpen', true) == resource.data.get('joinOpen', true)
                      )
                    );

      allow delete: if signedIn() && resource.data.ownerUid == uid();

      // ---- seats: a person who plays in this group, account optional ----
      match /members/{memberId} {
        allow read, create, delete: if isMember(groupId);

        // Members may edit roster entries freely EXCEPT the account link, which
        // decides whose history a seat belongs to. You may only ever attach
        // your OWN account, only to a seat nobody has claimed, and you may only
        // release your own. Without this, any member could hand another
        // member's identity to themselves.
        allow update: if isMember(groupId) && (
                        request.resource.data.get('uid', null) == resource.data.get('uid', null)
                        || (request.resource.data.get('uid', null) == uid()
                            && resource.data.get('uid', null) == null)
                        || (request.resource.data.get('uid', null) == null
                            && resource.data.get('uid', null) == uid())
                      );
      }

      // ---- recorded games ----
      match /games/{gameId} {
        allow read:   if isMember(groupId);
        allow create: if isMember(groupId)
                      && request.resource.data.createdBy == uid()
                      && request.resource.data.events is list
                      && request.resource.data.seats is list
                      && request.resource.data.result is map;
        // A recorded game's LOG (events/seats) is never rewritten — that's what
        // other members saw. But its AUTHOR may correct the recorded `result`
        // (roles/winner) they entered, since a mis-tapped role shouldn't be
        // permanent. Tightly scoped: only the author, and ONLY the `result`
        // field may change (diff().affectedKeys().hasOnly(['result'])).
        allow update: if isMember(groupId)
                      && resource.data.createdBy == uid()
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['result'])
                      && request.resource.data.result is map;
        // …but it may be DELETED — by the member who recorded it, or by the
        // group's owner (moderation). Anyone else in the group is denied, so a
        // member can't wipe another member's games. resource.data is the game
        // doc; the owner comes from the parent group document.
        allow delete: if isMember(groupId)
                      && (resource.data.createdBy == uid()
                          || group(groupId).ownerUid == uid());
      }

      // ---- shared "in the night" voices ----
      // A member can share a custom narration voice with the group: metadata
      // here, the two audio clips (base64) in the clips subcollection — one doc
      // each, so each gets the full ~1 MiB Firestore budget (the app caps them
      // well below that). Same ownership model as games: only the voice's author
      // or the group owner may delete it.
      match /voices/{voiceId} {
        allow read:   if isMember(groupId);
        allow create: if isMember(groupId)
                      && request.resource.data.createdBy == uid()
                      && request.resource.data.name is string
                      && request.resource.data.name.size() <= 40;
        allow update: if false;               // voice metadata is never rewritten
        allow delete: if isMember(groupId)
                      && (resource.data.createdBy == uid()
                          || group(groupId).ownerUid == uid());

        function voiceAuthor() {
          return get(/databases/$(database)/documents/groups/$(groupId)/voices/$(voiceId)).data.createdBy;
        }
        match /clips/{clipId} {
          allow read:   if isMember(groupId);
          // Only the voice's author may attach its clips. The size guard keeps a
          // clip document under Firestore's 1 MiB limit.
          allow create: if isMember(groupId)
                        && (clipId == "small" || clipId == "large")
                        && request.resource.data.data is string
                        && request.resource.data.data.size() < 990000
                        && voiceAuthor() == uid();
          allow update: if false;
          // Delete the clip (author or owner). Must happen before the parent
          // voice doc is removed, or voiceAuthor() has nothing to read.
          allow delete: if isMember(groupId)
                        && (voiceAuthor() == uid() || group(groupId).ownerUid == uid());
        }
      }

      // ---- ONLINE PLAY: live game tables (host-authoritative) ----
      // One member HOSTS a live game; their client is the dealer/referee. The
      // table doc holds only PUBLIC state (board, seats, phase) — every member
      // may read it, but only the host may write it. Each player's SECRETS live
      // in a private doc that ONLY that player can read and ONLY the host can
      // write, which is what keeps roles and drawn cards hidden. Tables are
      // ephemeral scratch state (a finished game is recorded as a normal
      // groups/{gid}/games doc); deleting one only removes live state, never
      // recorded history — and it's per-doc + host-scoped, so no bulk-delete
      // path (see DATA_SAFETY.md).
      match /tables/{tableId} {
        function tableHost() {
          return get(/databases/$(database)/documents/groups/$(groupId)/tables/$(tableId)).data.hostUid;
        }
        allow read:   if isMember(groupId);
        allow create: if isMember(groupId)
                      && request.resource.data.hostUid == uid()
                      && request.resource.data.status == "lobby";
        allow update, delete: if isMember(groupId) && resource.data.hostUid == uid();

        // Lobby seats: you write only your OWN; the host (or you) may remove one.
        match /players/{puid} {
          allow read:          if isMember(groupId);
          allow create, update: if isMember(groupId) && puid == uid();
          allow delete:        if isMember(groupId) && (puid == uid() || tableHost() == uid());
        }
        // Secrets: ONLY you read your own; ONLY the host writes them.
        match /private/{puid} {
          allow read:  if isMember(groupId) && puid == uid();
          allow write: if isMember(groupId) && tableHost() == uid();
        }
        // The host's own copy of the FULL authoritative state (roles, deck, hands)
        // so a host reload can resume. Only the host may ever read or write it —
        // this is the one place the whole secret game lives.
        match /host/{k} {
          allow read, write: if isMember(groupId) && tableHost() == uid();
        }
        // Action queue: a player submits their OWN moves; the host processes them.
        match /actions/{actionId} {
          allow read:           if isMember(groupId) && tableHost() == uid();
          allow create:         if isMember(groupId) && request.resource.data.by == uid();
          allow update, delete: if isMember(groupId) && tableHost() == uid();
        }
      }
    }

    // ---- community comments: the wiki-style notes on Rules & Game Theory ----
    // A global, shared layer keyed by a handbook item (`target`). Any signed-in
    // user may read all notes and add their OWN (authorship is pinned to their
    // uid, sizes are capped). Notes are never edited in place — you delete and
    // repost — and only the author can delete their own. This collection is
    // entirely separate from games/voices, so it cannot affect recorded history,
    // and delete is per-document + author-scoped, so there is no bulk-delete
    // path (see the DATA-SAFETY INVARIANT above).
    match /comments/{commentId} {
      allow read:   if signedIn();
      allow create: if signedIn()
                    && request.resource.data.authorUid == uid()
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 1000
                    && request.resource.data.target is string
                    && request.resource.data.target.size() > 0
                    && request.resource.data.target.size() <= 200
                    && request.resource.data.authorName is string
                    && request.resource.data.authorName.size() <= 60;
      allow update: if false;
      allow delete: if signedIn() && resource.data.authorUid == uid();
    }

    // ---- site content edited by the admin (e.g. the Game Theory handbook) ----
    // Public strategy text that the site owner curates and every visitor reads.
    // READ is open to the world (including signed-out visitors) so an edit reaches
    // everyone; WRITE is the admin ONLY. This is the actual privilege boundary —
    // the app's "Edit" button is just UI. Nothing here touches recorded history,
    // and there's no per-user data, so a public read exposes nothing sensitive.
    match /content/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
